# Copy to deploy/.env for docker compose; keep actual deployment values private.
MYSQL_ROOT_PASSWORD=change-this-local-database-password
RABBITMQ_USER=codeoj
RABBITMQ_PASSWORD=change-this-local-mq-password
# At least 32 bytes. Generate a new random value for each deployment.
JWT_SECRET=replace-this-with-a-new-random-secret-at-least-32-bytes
ENGINE_MODE=real
JUDGE_CONCURRENCY=2
MAX_PARALLEL_CONTAINERS=2
# 前端构建方式：默认在容器内构建（需 2GB+ 内存）。
# 内存不足的服务器改用预构建产物：先生成 deploy/web-dist，再取消下一行注释。
# OJ_WEB_DOCKERFILE=deploy/oj-web/Dockerfile.prebuilt
